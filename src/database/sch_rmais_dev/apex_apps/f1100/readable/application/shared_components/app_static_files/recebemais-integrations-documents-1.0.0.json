{
  "openapi": "3.0.0",
  "info": {
    "title": "RecebeMais API para integração de documentos eletrônicos",
    "description": "Para utilizar esta API, siga os passos de autenticação:\n1. Solicite o **client_id** e **client_secret** à equipe de integrações do RecebeMais.\n2. Obtenha o token de acesso (Bearer Token) enviando as credenciais para:\n   `https://hdi-test.rm.digital:8443/ords/rmais_dev/oauth/token`\n3. Utilize o token recebido no cabeçalho de todas as requisições: \n   `Authorization: Bearer <seu_token>`\n",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://hdi-test.rm.digital:8443/ords/rmais_dev/v1/integrations/"
    }
  ],
  "paths": {
    "/documents": {
      "post": {
        "tags": [
          "Documents"
        ],
        "description": "Endpoint para envio de **documentos eletrônicos** a serem importados no sistema **RecebeMais**",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/v1.integrations_ITEM"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Documento criado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseSuccess"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor ou regra de negócio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseError"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
